+// O gathering node é onde o StarPU executa a partição/despartição read-only. Para handles com
+// home_node = -1 o padrão é a STARPU_MAIN_RAM, o que faria cada cubo escrito na GPU ir inteiro
+// para a RAM só para as faces voltarem para a GPU. -1 mantém o padrão do StarPU.
+static inline void plan_cube_partition(starpu_data_handle_t handle, starpu_data_handle_t children[CUBE_FACE_NPARTS], int gathering_node){
+    if(gathering_node >= 0)
+        starpu_data_set_gathering_node(handle, (unsigned) gathering_node);
+    starpu_data_partition_plan(handle, &g_cube_face_filter, children);
+}
 
